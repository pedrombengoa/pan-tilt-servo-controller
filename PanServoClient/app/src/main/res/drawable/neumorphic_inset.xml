<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inset effect: dark shadow on top-left -->
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/neumorphic_dark_shadow" />
        </shape>
    </item>
    <!-- Light on bottom-right -->
    <item android:left="4dp" android:top="4dp">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/neumorphic_light_shadow" />
        </shape>
    </item>
    <!-- Surface -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/neumorphic_background" />
        </shape>
    </item>
</layer-list>

