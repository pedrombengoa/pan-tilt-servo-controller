<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark shadow (bottom-right) -->
    <item android:left="5dp" android:top="5dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_dark_shadow" />
        </shape>
    </item>
    <!-- Light shadow (top-left) -->
    <item android:left="0dp" android:top="0dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_light_shadow" />
        </shape>
    </item>
    <!-- Main surface with gradient -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/knob_highlight"
                android:endColor="@color/knob_shadow"
                android:angle="135"
                android:type="linear" />
        </shape>
    </item>
    <!-- Inner highlight ring -->
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_background" />
        </shape>
    </item>
</layer-list>

