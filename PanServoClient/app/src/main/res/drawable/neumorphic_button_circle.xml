<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark shadow (bottom-right) -->
    <item android:left="3dp" android:top="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_dark_shadow" />
        </shape>
    </item>
    <!-- Light shadow (top-left) -->
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_light_shadow" />
        </shape>
    </item>
    <!-- Surface -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_background" />
        </shape>
    </item>
</layer-list>

