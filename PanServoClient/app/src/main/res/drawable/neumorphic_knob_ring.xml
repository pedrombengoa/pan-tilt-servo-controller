<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inset effect: dark shadow on top-left (pressed in) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_dark_shadow" />
        </shape>
    </item>
    <!-- Light on bottom-right -->
    <item android:left="6dp" android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_light_shadow" />
        </shape>
    </item>
    <!-- Surface -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/neumorphic_background" />
        </shape>
    </item>
</layer-list>

