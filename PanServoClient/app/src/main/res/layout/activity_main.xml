<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neumorphic_background"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">


        <!-- ==================== HEADER CARD ==================== -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/neumorphic_card"
            android:elevation="0dp"
            android:minHeight="72dp"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp"
            app:title="">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/header_title"
                    android:textColor="@color/text_main"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp" />

                <ImageButton
                    android:id="@+id/btnConnect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/neumorphic_bluetooth_bg"
                    android:src="@drawable/ic_bluetooth_disabled"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:contentDescription="@string/bluetooth_toggle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- ==================== MAIN CONTROLS CARD ==================== -->
        <LinearLayout
            android:id="@+id/controlsCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:background="@drawable/neumorphic_card"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="20dp">

            <!-- Top row: Move icon + Pan direction label -->

            <!-- Main content: Knob (left) + Angle Controls (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- ===== LEFT: Joystick/Knob Area ===== -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Pan label + Knob + Tilt label row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Pan label (left of knob) -->

                        <!-- Knob area -->
                        <FrameLayout
                            android:layout_width="150dp"
                            android:layout_height="150dp">

                            <!-- Outer ring (inset) -->

                            <!-- Inner knob (raised, centered) -->
                            <ImageView
                                android:id="@+id/speedometer"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_compass_arrow"
                                android:contentDescription="@string/servo_knob" />

                        </FrameLayout>

                        <!-- Tilt label + arrow (right of knob) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:orientation="vertical"/>

                    </LinearLayout>

                    <!-- Tilt label below knob -->

                </LinearLayout>

                <!-- ===== RIGHT: Angle Controls ===== -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <!-- Pan Angle Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/pan_angle"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/neumorphic_inset"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tvAngle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="72dp"
                            android:gravity="center"
                            android:text="@string/default_angle"
                            android:textColor="@color/text_main"
                            android:textSize="32sp"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <!-- Spacer -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp" />

                    <!-- Tilt Angle Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/tilt_angle"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/neumorphic_inset"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <ImageButton
                            android:id="@+id/btnUp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/neumorphic_button_circle"
                            android:src="@drawable/ic_add"
                            android:scaleType="centerInside"
                            android:padding="8dp"
                            android:contentDescription="@string/tilt_plus" />

                        <TextView
                            android:id="@+id/tvTiltAngle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:minWidth="72dp"
                            android:gravity="center"
                            android:text="@string/default_angle"
                            android:textColor="@color/text_main"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnDown"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/neumorphic_button_circle"
                            android:src="@drawable/ic_remove"
                            android:scaleType="centerInside"
                            android:padding="8dp"
                            android:contentDescription="@string/tilt_minus" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ==================== BOTTOM CONTROLS CARD ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:background="@drawable/neumorphic_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="20dp">

            <!-- Previous -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSkipPrevious"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/neumorphic_button_dark_circle"
                    android:src="@drawable/ic_fast_rewind"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="@string/previous" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/previous"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Play -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/neumorphic_button_dark_circle"
                    android:src="@drawable/ic_play_arrow_white"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="@string/play" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/play"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Pause -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnStop"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/neumorphic_button_dark_circle"
                    android:src="@drawable/ic_stop_white"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="@string/stop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/stop"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Next -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSkipNext"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/neumorphic_button_dark_circle"
                    android:src="@drawable/ic_fast_forward"
                    android:scaleType="centerInside"
                    android:padding="16dp"
                    android:contentDescription="@string/next" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/next"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

</LinearLayout>
