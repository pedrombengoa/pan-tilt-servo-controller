<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (night). -->
    <style name="Theme.PanServoClient" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Neumorphic colors -->
        <item name="colorPrimary">@color/neumorphic_accent_blue</item>
        <item name="colorPrimaryVariant">@color/neumorphic_dark_shadow</item>
        <item name="colorOnPrimary">@color/text_main</item>
        <item name="colorSecondary">@color/neumorphic_accent_blue</item>
        <item name="colorOnSecondary">@color/text_main</item>
        <item name="android:colorBackground">@color/neumorphic_background</item>
        <item name="android:windowBackground">@color/neumorphic_background</item>
        <!-- Light status bar with dark icons -->
        <item name="android:statusBarColor">@color/neumorphic_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>